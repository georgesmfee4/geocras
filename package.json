{
  "name": "geocras",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "mobile": "npm run start --workspace @geocras/mobile",
    "api": "npm run dev --workspace @geocras/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "docs:pdf": "node docs/build-pdf.mjs",
    "db:migrate": "npm run db:migrate --workspace @geocras/api",
    "db:seed": "npm run db:seed --workspace @geocras/api",
    "android": "npm run android --workspace @geocras/mobile",
    "ios": "npm run ios --workspace @geocras/mobile"
  },
  "overrides": {
    "react-dom": "19.1.0"
  }
}
